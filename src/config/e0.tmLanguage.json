{
  "name": "e0",
  "scopeName": "source.e0",
  "patterns": [
    {
      "name": "comment.block.e0",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "comment.line.double-slash.e0",
      "match": "//.*$"
    },
    {
      "name": "keyword.control.e0",
      "match": "\\b(size|config|format|clauses|if|else)\\b"
    },
    {
      "name": "keyword.control.e0",
      "match": "\\b(binarySearch)\\s+(min|max)\\b"
    },
    {
      "name": "keyword.operator.e0",
      "match": "\\{[~*+\\-:?<>]+\\}"
    },
    {
      "name": "keyword.operator.e0",
      "match": "(\\+=|/%|\\?= |%%|\\{~\\}|\\^:|\\|:|\\+:|<:>|\\{<:>\\}|~|\\*\\*|!\\*|%|\\?\\*|<<\\*|\\*>>|<<|>>|:<<:|:>>:|&&|\\|\\||<=|>=|!=|==|\\+|-|\\*|/|\\=|:|\\?|!|&|\\^|\\||<|>|,|\\\"|\\$)"
    },
    {
      "name": "punctuation.definition.bracket.e0",
      "match": "[(){}\\[\\]]"
    },
    {
      "name": "punctuation.terminator.statement.e0",
      "match": ";"
    },
    {
      "name": "constant.numeric.e0",
      "match": "\\b0[xXbBoOdD][0-9a-fA-F]+(\\.[0-9a-fA-F]+)?\\b|\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "name": "constant.language.boolean.e0",
      "match": "\\b(true|false)\\b"
    },
    {
      "name": "support.function.e0",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=[ \\t]*\\()"
    },
    {
      "name": "variable.other.e0",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  ]
}
